# MAESTRO Engine Configuration Template
# Copy to .env and fill in your values
# See docs/configuration.md for detailed documentation

# ==================== ENVIRONMENT ====================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
VERSION=3.0.0

# ==================== SERVICE CONFIGURATION ====================

# MAESTRO Engine
ENGINE_HOST=0.0.0.0
ENGINE_PORT=5000
ENGINE_URL=http://localhost:5000
ENGINE_RELOAD=true

# Unified BFF Service
BFF_HOST=0.0.0.0
BFF_PORT=4001
BFF_URL=http://localhost:4001
BFF_RELOAD=true

# Frontend
FRONTEND_URL=http://localhost:4200
FRONTEND_PORT=4200

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=3600

# ==================== FILE PATHS ====================

# Working directories
PROJECTS_DIR=/tmp/maestro_projects
OUTPUT_DIR=/tmp/maestro_output
TEMP_DIR=/tmp/maestro_temp

# Log files
ENGINE_LOG_FILE=/tmp/maestro_engine.log
BFF_LOG_FILE=/tmp/bff_service.log

# PID files
ENGINE_PID_FILE=/tmp/maestro_engine.pid
BFF_PID_FILE=/tmp/bff_service.pid

# ==================== API KEYS ====================

# Anthropic API (REQUIRED - get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_api_key_here

# GitHub Token (optional - for template publishing)
GITHUB_TOKEN=your_github_token_here

# ==================== SERVICE INTEGRATION ====================

# Quality Fabric (optional)
QUALITY_FABRIC_ENABLED=false
QUALITY_FABRIC_URL=http://localhost:8000

# Template Registry (optional)
TEMPLATE_REGISTRY_ENABLED=false
TEMPLATE_REGISTRY_URL=http://localhost:9600

# RAG Service (optional)
RAG_ENABLED=false
RAG_SERVICE_URL=http://localhost:9803
CHROMA_PERSIST_DIR=./chroma_db
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==================== SECURITY ====================

# JWT Configuration
JWT_SECRET_KEY=change_this_in_production_use_secrets_manager
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# CORS
CORS_ORIGINS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==================== WORKFLOW CONFIGURATION ====================

# Session Management
SESSION_TTL=3600
MAX_CONCURRENT_WORKFLOWS=10

# Execution Modes
ENABLE_PARALLEL_EXECUTION=true
ENABLE_HIERARCHICAL_MODE=true
ENABLE_SEQUENTIAL_MODE=true
DEFAULT_EXECUTION_MODE=dag

# Timeouts (seconds)
WORKFLOW_TIMEOUT=3600
PERSONA_TIMEOUT=300

# MCP/UTCP
ENABLE_MCP=true
MCP_CACHE_DIR=/tmp/mcp_cache
MCP_CACHE_TTL=3600

# ==================== LOGGING & MONITORING ====================

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=maestro-engine
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
