# =============================================================================
# Maestro Gateway - Sandbox Environment
# Port offset: +10000
# =============================================================================

ENVIRONMENT=sandbox
GATEWAY_PORT=14000

# Backend Services (Sandbox ports)
# Note: URLs must include path prefix to match gateway route stripping

# Base backend URL (for WebSocket/Socket.io routes)
BACKEND_BASE_URL=http://localhost:14100

# Auth Service (login, register, etc.)
AUTH_SERVICE_URL=http://localhost:14100/api/v1/auth

# API Routes with path prefixes (to prevent AUTH_SERVICE_URL override)
PERSONAS_SERVICE_URL=http://localhost:14100/api/personas
AI_AGENTS_SERVICE_URL=http://localhost:14100/api/v1/ai-agents
TEAMS_SERVICE_URL=http://localhost:14100/api/teams
MISSIONS_SERVICE_URL=http://localhost:14100/api/missions

# Other Backend Services
BFF_SERVICE_URL=http://localhost:14001
MAESTRO_ENGINE_URL=http://localhost:15000
TEMPLATE_SERVICE_URL=http://localhost:19600
RAG_SERVICE_URL=http://localhost:19803
MCP_SERVICE_URL=http://localhost:19800
QUALITY_FABRIC_URL=http://localhost:18000
COORDINATOR_SERVICE_URL=http://localhost:18002
ORCHESTRATION_SERVICE_URL=http://localhost:18004
WORKFLOW_API_URL=http://localhost:15001
WORKFLOWS_SERVICE_URL=http://localhost:14100/api/v1/workflows
COLLABORATION_SERVICE_URL=http://localhost:14100/api/collaboration
COLLABORATION_BFF_URL=http://localhost:14002
FOUNDRY_SERVICE_URL=http://localhost:14100/api/foundry
DAG_WORKFLOWS_SERVICE_URL=http://localhost:14100/api/v1/dag-workflows
EXECUTION_SERVICE_URL=http://localhost:14100/api/v1/execution-platform
PORTAINER_URL=http://localhost:39000

# Frontend URL (for CORS) - Use public IP for external access
FRONTEND_URL=http://3.10.213.208:13000

# JWT Secret
JWT_SECRET=sandbox-jwt-secret-change-in-production
