# MAESTRO Engine Configuration - TEST
# Environment: Testing/CI

# ==================== ENVIRONMENT ====================
ENVIRONMENT=test
DEBUG=true
VERSION=3.0.0

# ==================== SERVICE CONFIGURATION ====================

# MAESTRO Engine
ENGINE_HOST=0.0.0.0
ENGINE_PORT=15000
ENGINE_URL=http://localhost:15000
ENGINE_RELOAD=false

# Unified BFF Service
BFF_HOST=0.0.0.0
BFF_PORT=14001
BFF_URL=http://localhost:14001
BFF_RELOAD=false

# Frontend
FRONTEND_URL=http://localhost:14200
FRONTEND_PORT=14200

# Redis (use separate test instance)
REDIS_URL=redis://localhost:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_TTL=600

# ==================== FILE PATHS ====================

# Working directories (use tmp for tests)
PROJECTS_DIR=/tmp/maestro_test/projects
OUTPUT_DIR=/tmp/maestro_test/output
TEMP_DIR=/tmp/maestro_test/temp

# Log files
ENGINE_LOG_FILE=/tmp/maestro_test_engine.log
BFF_LOG_FILE=/tmp/maestro_test_bff.log

# PID files
ENGINE_PID_FILE=/tmp/maestro_test_engine.pid
BFF_PID_FILE=/tmp/maestro_test_bff.pid

# ==================== API KEYS ====================

# Anthropic API (use test key)
ANTHROPIC_API_KEY=test_key

# GitHub Token (optional in test)
GITHUB_TOKEN=

# ==================== SERVICE INTEGRATION ====================

# Quality Fabric (disabled in test)
QUALITY_FABRIC_ENABLED=false
QUALITY_FABRIC_URL=http://localhost:18000

# Template Registry (disabled in test)
TEMPLATE_REGISTRY_ENABLED=false
TEMPLATE_REGISTRY_URL=http://localhost:19600

# RAG Service (disabled in test)
RAG_ENABLED=false
RAG_SERVICE_URL=http://localhost:19803
CHROMA_PERSIST_DIR=/tmp/maestro_test/chroma_db
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==================== SECURITY ====================

# JWT Configuration (test keys)
JWT_SECRET_KEY=test_secret_key_not_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# CORS (allow all in test)
CORS_ORIGINS=["*"]

# Rate Limiting (disabled in test)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ==================== WORKFLOW CONFIGURATION ====================

# Session Management
SESSION_TTL=600
MAX_CONCURRENT_WORKFLOWS=5

# Execution Modes
ENABLE_PARALLEL_EXECUTION=true
ENABLE_HIERARCHICAL_MODE=true
ENABLE_SEQUENTIAL_MODE=true
DEFAULT_EXECUTION_MODE=sequential

# Timeouts (shorter for tests)
WORKFLOW_TIMEOUT=300
PERSONA_TIMEOUT=60

# MCP/UTCP
ENABLE_MCP=false
MCP_CACHE_DIR=/tmp/maestro_test/mcp_cache
MCP_CACHE_TTL=600

# ==================== LOGGING & MONITORING ====================

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ENABLE_STRUCTURED_LOGGING=false

# Metrics (disabled in test)
ENABLE_METRICS=false
METRICS_PORT=19090

# OpenTelemetry (disabled in test)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=maestro-engine-test
OTEL_EXPORTER_ENDPOINT=http://localhost:14317
