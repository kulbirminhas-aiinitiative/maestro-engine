# =============================================================================
# Maestro Gateway - Development Environment
# Port Strategy per ENVIRONMENT_PORT_STRATEGY.md
# Port offset: 0 (base ports)
# =============================================================================

ENVIRONMENT=development
GATEWAY_PORT=4000

# Backend Services (Development ports - base)
# Backend on port 4100 per ENVIRONMENT_PORT_STRATEGY.md
# Note: URLs must include path prefix to match gateway route stripping

# Base backend URL (for WebSocket/Socket.io routes)
BACKEND_BASE_URL=http://localhost:4100

# Auth Service (login, register, etc.)
AUTH_SERVICE_URL=http://localhost:4100/api/v1/auth

# API Routes with path prefixes (to prevent AUTH_SERVICE_URL override)
PERSONAS_SERVICE_URL=http://localhost:4100/api/personas
AI_AGENTS_SERVICE_URL=http://localhost:4100/api/v1/ai-agents
TEAMS_SERVICE_URL=http://localhost:4100/api/teams
MISSIONS_SERVICE_URL=http://localhost:4100/api/missions

# BFF and Other Services
BFF_SERVICE_URL=http://localhost:4001
MAESTRO_ENGINE_URL=http://localhost:5000
TEMPLATE_SERVICE_URL=http://localhost:9600
RAG_SERVICE_URL=http://localhost:9803
MCP_SERVICE_URL=http://localhost:9800
QUALITY_FABRIC_URL=http://localhost:8000
COORDINATOR_SERVICE_URL=http://localhost:8002
ORCHESTRATION_SERVICE_URL=http://localhost:8004
WORKFLOW_API_URL=http://localhost:5001
WORKFLOWS_SERVICE_URL=http://localhost:4100/api/v1/workflows
COLLABORATION_SERVICE_URL=http://localhost:4100/api/collaboration
COLLABORATION_BFF_URL=http://localhost:4002
FOUNDRY_SERVICE_URL=http://localhost:4100/api/foundry
DAG_WORKFLOWS_SERVICE_URL=http://localhost:4100/api/v1/dag-workflows
EXECUTION_SERVICE_URL=http://localhost:4100/api/v1/execution-platform
PORTAINER_URL=http://localhost:29000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret
JWT_SECRET=maestro-development-secret-do-not-use-in-production
