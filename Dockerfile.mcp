# Dockerfile for MCP Service
# Port: 9800
# Features: Hot Claude sessions, MCP cache, session state, audit logging

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=1.8.0 \
    POETRY_HOME="/opt/poetry" \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 -

ENV PATH="/opt/poetry/bin:$PATH"

WORKDIR /app

COPY pyproject.toml poetry.lock* ./

RUN poetry install --no-root --only main

# Copy source code
COPY src/ ./src/
COPY config/ ./config/

# Create MCP cache directory
RUN mkdir -p /tmp/mcp_cache

# Create non-root user
RUN useradd -m -u 1000 maestro && \
    chown -R maestro:maestro /app /tmp/mcp_cache

USER maestro

EXPOSE 9800

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9800/health || exit 1

# Run MCP service
# TODO: Create dedicated MCP service entry point
CMD ["poetry", "run", "uvicorn", "src.maestro_mcp.hot_claude_live_backend_sdk:app", "--host", "0.0.0.0", "--port", "9800"]
