# Dockerfile for RAG Service
# Port: 9803
# Features: Vector embeddings, semantic search, context retrieval

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=1.8.0 \
    POETRY_HOME="/opt/poetry" \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 -

ENV PATH="/opt/poetry/bin:$PATH"

WORKDIR /app

COPY pyproject.toml poetry.lock* ./

# Install with chromadb for vector storage
RUN poetry install --no-root --only main --extras chromadb || \
    poetry install --no-root --only main

# Copy source code
COPY src/ ./src/
COPY config/ ./config/

# Create ChromaDB persist directory
RUN mkdir -p /app/chroma_db

# Create non-root user
RUN useradd -m -u 1000 maestro && \
    chown -R maestro:maestro /app

USER maestro

EXPOSE 9803

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9803/health || exit 1

# Run RAG service
# TODO: Create dedicated RAG service entry point
CMD ["poetry", "run", "python", "-m", "src.rag.api"]
