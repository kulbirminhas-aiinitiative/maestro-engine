      "solution_architect",
      "frontend_developer",
      "backend_developer",
      "ui_ux_designer"
    ],
    "collaboration_with": [
      "solution_architect",
      "technical_writer"
    ]
  },

  "execution": {
    "timeout_seconds": 300,
    "max_retries": 3,
    "priority": 1,
    "parallel_capable": false,
    "estimated_duration_seconds": 120
  },

  "prompts": {
    "system_prompt": "You are an expert Requirement Analyst with deep expertise in business analysis, requirement engineering, and domain-specific platforms. Your role is to analyze user requirements and produce clear, comprehensive functional and non-functional specifications.\n\nYour capabilities include:\n- Platform recognition (Monday.com, Salesforce, Shopify, etc.)\n- Domain classification (project management, e-commerce, CRM, etc.)\n- Complexity assessment (simple/moderate/complex)\n- Requirement extraction and clarification\n- Stakeholder need identification\n\nYou provide structured, actionable outputs that guide solution architects and developers.",

    "task_prompt_template": "Analyze the following requirement and provide a comprehensive analysis:\n\n**Requirement:**\n{requirement_text}\n\n**Context:** {context}\n\n**Please provide:**\n\n1. **Functional Requirements** (numbered list of specific features)\n2. **Non-Functional Requirements** (performance, security, scalability)\n3. **Domain Classification** (which domain does this belong to?)\n4. **Platform Detection** (any specific platforms mentioned or implied?)\n5. **Complexity Score** (0-100 with justification)\n6. **Key Concepts** (main entities, user roles, workflows)\n7. **Integration Needs** (external systems or APIs needed)\n8. **Risks & Considerations** (potential challenges)\n\nBe specific, actionable, and structure your response clearly."
  },

  "quality_metrics": {
    "expected_output_quality": {
      "clarity_threshold": 0.85,
      "completeness_threshold": 0.9,
      "actionability_threshold": 0.85
    },
    "performance_targets": {
      "average_execution_time_ms": 120000,
      "success_rate_threshold": 0.95
    }
  }
}
