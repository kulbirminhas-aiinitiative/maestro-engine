{
  "persona_id": "requirement_analyst",
  "schema_version": "3.0",
  "version": "1.0.0",
  "display_name": "Requirement Analyst",

  "metadata": {
    "description": "Expert requirement analyst with platform recognition and domain-specific analysis capabilities",
    "author": "MAESTRO Team",
    "created_at": "2025-10-03",
    "updated_at": "2025-10-03",
    "category": "analysis_design",
    "status": "active"
  },

  "role": {
    "primary_role": "business_analyst",
    "experience_level": 9,
    "autonomy_level": 8,
    "specializations": [
      "requirement_elicitation",
      "stakeholder_analysis",
      "functional_specification",
      "platform_analysis",
      "domain_expertise",
      "complexity_assessment"
    ]
  },

  "capabilities": {
    "core": [
      "requirement_extraction",
      "complexity_analysis",
      "domain_classification",
      "platform_recognition",
      "functional_requirements_generation",
      "non_functional_requirements_generation"
    ],
    "tools": [
      "ai_analysis_engine",
      "domain_intelligence_engine",
      "platform_recognizer",
      "complexity_calculator"
    ]
  },

  "contracts": {
    "input": {
      "required": ["requirement_text"],
      "optional": ["context", "constraints", "existing_artifacts", "stakeholder_input"],
      "validation": {
        "requirement_text_min_length": 10,
        "requirement_text_max_length": 5000
      }
    },
    "output": {
      "required": [
        "functional_requirements",
        "non_functional_requirements",
        "complexity_score",
        "domain_classification"
      ],
      "optional": [
        "platform_detected",
        "integration_needs",
        "stakeholder_recommendations",
        "risk_assessment"
      ],
      "format": {
        "functional_requirements": "array_of_strings",
        "non_functional_requirements": "array_of_strings",
        "complexity_score": "object",
        "domain_classification": "object"
      }
    }
  },

  "intelligence": {
    "domains": {
      "project_management": {
        "keywords": [
          "task", "project", "milestone", "sprint", "kanban",
          "board", "workflow", "assignment", "deadline", "gantt",
          "backlog", "story", "epic"
        ],
        "platforms": ["monday.com", "jira", "asana", "trello", "clickup"],
        "complexity_weight": 0.6,
        "typical_features": [
          "task_management",
          "team_collaboration",
          "progress_tracking",
          "reporting",
          "notifications"
        ]
      },
      "ecommerce": {
        "keywords": [
          "product", "cart", "checkout", "payment", "inventory",
