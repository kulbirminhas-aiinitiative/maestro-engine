    "complexity_factors": {
      "base_factors": {
        "entity_count_weight": 0.15,
        "user_role_count_weight": 0.1,
        "integration_count_weight": 0.2,
        "security_requirement_weight": 0.15,
        "scale_requirement_weight": 0.15,
        "domain_complexity_weight": 0.25
      },
      "scoring": {
        "simple": {"min": 0, "max": 30, "description": "Basic CRUD, single user type, no integrations"},
        "moderate": {"min": 31, "max": 60, "description": "Multiple entities, some integrations, moderate scale"},
        "complex": {"min": 61, "max": 100, "description": "Multi-platform, high scale, complex security"}
      }
    },

    "platform_indicators": {
      "monday.com": ["board", "pulse", "workspace", "monday", "item", "column"],
      "salesforce": ["salesforce", "sfdc", "apex", "visualforce", "lightning"],
      "shopify": ["shopify", "liquid template", "storefront"],
      "jira": ["jira", "issue", "epic", "sprint", "scrum"],
      "slack": ["slack", "channel", "workspace", "bot"],
      "stripe": ["stripe", "payment gateway", "checkout session"],
