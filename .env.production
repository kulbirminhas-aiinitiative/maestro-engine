# MAESTRO Engine Configuration - PRODUCTION
# Environment: Production

# ==================== ENVIRONMENT ====================
ENVIRONMENT=production
DEBUG=false
VERSION=3.0.0

# ==================== SERVICE CONFIGURATION ====================

# MAESTRO Engine
ENGINE_HOST=0.0.0.0
ENGINE_PORT=5000
ENGINE_URL=https://maestro-api.your-domain.com
ENGINE_RELOAD=false

# Unified BFF Service
BFF_HOST=0.0.0.0
BFF_PORT=4001
BFF_URL=https://maestro-bff.your-domain.com
BFF_RELOAD=false

# Frontend
FRONTEND_URL=https://maestro.your-domain.com
FRONTEND_PORT=4200

# Redis (use managed service in production)
REDIS_URL=redis://prod-redis.your-domain.com:6379
REDIS_HOST=prod-redis.your-domain.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=7200

# ==================== FILE PATHS ====================

# Working directories (use persistent storage in production)
PROJECTS_DIR=/var/maestro/projects
OUTPUT_DIR=/var/maestro/output
TEMP_DIR=/var/maestro/temp

# Log files (use log aggregation service in production)
ENGINE_LOG_FILE=/var/log/maestro/engine.log
BFF_LOG_FILE=/var/log/maestro/bff.log

# PID files
ENGINE_PID_FILE=/var/run/maestro_engine.pid
BFF_PID_FILE=/var/run/bff_service.pid

# ==================== API KEYS ====================

# Anthropic API (REQUIRED - use Secrets Manager in production)
ANTHROPIC_API_KEY=

# GitHub Token (use Secrets Manager in production)
GITHUB_TOKEN=

# ==================== SERVICE INTEGRATION ====================

# Quality Fabric
QUALITY_FABRIC_ENABLED=false
QUALITY_FABRIC_URL=https://quality-fabric.your-domain.com

# Template Registry
TEMPLATE_REGISTRY_ENABLED=false
TEMPLATE_REGISTRY_URL=https://templates.your-domain.com

# RAG Service
RAG_ENABLED=false
RAG_SERVICE_URL=https://rag.your-domain.com
CHROMA_PERSIST_DIR=/var/maestro/chroma_db
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==================== SECURITY ====================

# JWT Configuration (use Secrets Manager for production keys)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# CORS (restrict to your domains in production)
CORS_ORIGINS=["https://maestro.your-domain.com","https://app.your-domain.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=60

# ==================== WORKFLOW CONFIGURATION ====================

# Session Management
SESSION_TTL=7200
MAX_CONCURRENT_WORKFLOWS=20

# Execution Modes
ENABLE_PARALLEL_EXECUTION=true
ENABLE_HIERARCHICAL_MODE=true
ENABLE_SEQUENTIAL_MODE=true
DEFAULT_EXECUTION_MODE=dag

# Timeouts
WORKFLOW_TIMEOUT=3600
PERSONA_TIMEOUT=300

# MCP/UTCP
ENABLE_MCP=true
MCP_CACHE_DIR=/var/maestro/mcp_cache
MCP_CACHE_TTL=3600

# ==================== LOGGING & MONITORING ====================

# Logging
LOG_LEVEL=WARNING
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# OpenTelemetry (enable in production)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=maestro-engine-prod
OTEL_EXPORTER_ENDPOINT=https://otel-collector.your-domain.com:4317
