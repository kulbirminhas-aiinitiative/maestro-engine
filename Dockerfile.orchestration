# Dockerfile for Orchestration Gateway
# Port: 8004
# Features: Workflow routing, team coordination, task distribution

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=1.8.0 \
    POETRY_HOME="/opt/poetry" \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 -

ENV PATH="/opt/poetry/bin:$PATH"

WORKDIR /app

# Create directory structure for shared packages
RUN mkdir -p /maestro-shared/packages

# Copy shared packages from parent context
COPY maestro-shared/packages /maestro-shared/packages

# Copy dependency files
COPY maestro-engine-new/pyproject.toml maestro-engine-new/poetry.lock* ./

# Install dependencies
RUN poetry install --no-root --only main

# Copy source code
COPY maestro-engine-new/src/ ./src/
COPY maestro-engine-new/config/ ./config/

# Create non-root user
RUN useradd -m -u 1000 maestro && \
    chown -R maestro:maestro /app

USER maestro

EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

# Run orchestration gateway
# TODO: Create dedicated orchestration service entry point
CMD ["poetry", "run", "uvicorn", "src.orchestration.maestro_unified_orchestration_gateway:app", "--host", "0.0.0.0", "--port", "8004"]
